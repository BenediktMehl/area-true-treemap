{
  "name": "improved-treemap",
  "version": "1.0.0",
  "description": "Area-true squarified treemap layout with configurable gaps between nodes, without losing any node.",
  "keywords": [
    "treemap",
    "squarify",
    "layout",
    "visualization",
    "hierarchy",
    "area-true"
  ],
  "license": "BSD-3-Clause",
  "author": "Benedikt Mehl",
  "repository": {
    "type": "git",
    "url": "https://github.com/BenediktMehl/ImprovedTreeMap.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
